---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Anna Reshetnyak', description = 'ML Engineer · AI Researcher · ITMO MSc' } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>
    (() => {
      const detectLang = () => {
        try {
          const stored = window.localStorage.getItem('lang');
          if (stored === 'ru' || stored === 'en') return stored;
        } catch {}

        const browserLang = navigator.language || '';
        return /^ru\b/i.test(browserLang) ? 'ru' : 'en';
      };

      const lang = detectLang();
      document.documentElement.lang = lang;
      window.__siteLang = lang;
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <style>
    html[lang='ru'] .lang-en,
    html[lang='en'] .lang-ru {
      display: none !important;
    }
  </style>
</head>
<body>
<div class="container">
  <nav>
    <a href="/" class="nav-logo">Anna Reshetnyak</a>
    <div class="nav-right">
      <ul class="nav-links">
        <li>
          <a href="/blog" class={path.startsWith('/blog') ? 'active' : ''}>
            <span class="lang-ru">Блог</span>
            <span class="lang-en">Blog</span>
          </a>
        </li>
        <li>
          <a href="/#about">
            <span class="lang-ru">Обо мне</span>
            <span class="lang-en">About</span>
          </a>
        </li>
        <li>
          <a href="/#contact">
            <span class="lang-ru">Контакты</span>
            <span class="lang-en">Contact</span>
          </a>
        </li>
      </ul>
      <button class="lang-toggle" onclick="toggleLang()" id="langBtn">
        <span class="lang-ru">EN</span>
        <span class="lang-en">RU</span>
      </button>
    </div>
  </nav>

  <slot />

  <footer>
    <span>© 2025 Anna Reshetnyak</span>
    <span>
      <span class="lang-ru">Создано с любопытством</span>
      <span class="lang-en">Built with curiosity</span>
    </span>
  </footer>
</div>

<script>
  let lang = (window as any).__siteLang || 'en';

  function applyNav(l: string) {
    document.documentElement.lang = l;
    (window as any).__siteLang = l;
  }

  (window as any).toggleLang = () => {
    lang = lang === 'ru' ? 'en' : 'ru';
    localStorage.setItem('lang', lang);
    applyNav(lang);
  };

  applyNav(lang);
</script>
</body>
</html>
